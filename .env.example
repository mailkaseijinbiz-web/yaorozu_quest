# 八百万クエスト — 環境変数サンプル
#
# すべて任意です。未設定でもアプリはフォールバックで動作します。
# Vercel では Project Settings → Environment Variables に同名で登録してください
# （SERVICE_ROLE_KEY などの秘密値はクライアントに出ないよう、NEXT_PUBLIC_ を付けないこと）。

# ── データ永続化（Supabase）──
# 未設定の場合は localStorage のみで動作（端末内に保存・クラウド同期なし）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AIチャット（神との会話）──
# どちらか一方でOK。両方未設定ならルールベースの定型応答にフォールバック。
# GEMINI_API_KEY を優先的に利用（gemini-2.5-flash）。
GEMINI_API_KEY=
OPENAI_API_KEY=
