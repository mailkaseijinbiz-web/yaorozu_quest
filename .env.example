# 八百万クエスト 環境変数サンプル
# ローカルでは .env.local にコピーして使用。Vercel では Project Settings > Environment Variables に登録する。
# .env* は .gitignore 済み（このサンプルファイルのみコミット対象）。

# ── 管理画面 (/admin) ──────────────────────────────
# 必須。未設定だと管理画面にログインできない。本番では必ず強固な値に変更すること。
ADMIN_PASSWORD=change-me-strong-password

# ── データ永続化 (Supabase) ────────────────────────
# サーバー専用（API Route のみ）。サービスロールキーはクライアントに露出させない。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ブラウザ側から参照（NEXT_PUBLIC_ プレフィックス = クライアントに露出する）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI チャット（神との会話）任意 ──────────────────
# 未設定でもルールベースの定型文にフォールバックする。
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Web Push 通知（任意）───────────────────────────
# VAPID 鍵ペア。未設定だと Push 機能は無効。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
