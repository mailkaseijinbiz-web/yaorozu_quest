# 八百万クエスト 環境変数サンプル
# ローカルでは .env.local にコピーして使用。Vercel では Project Settings > Environment Variables に登録する。
# .env* は .gitignore 済み（このサンプルファイルのみコミット対象）。

# ── 管理画面 (/admin) ──────────────────────────────
# 必須。未設定だと管理画面にログインできない。本番では必ず強固な値に変更すること。
ADMIN_PASSWORD=change-me-strong-password

# ── データ永続化 (Supabase) ────────────────────────
# サーバー専用（API Route のみ）。サービスロールキーはクライアントに露出させない。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ブラウザ側から参照（NEXT_PUBLIC_ プレフィックス = クライアントに露出する）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI チャット（神との会話）任意 ──────────────────
# 未設定でもルールベースの定型文にフォールバックする。
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 生成AIの節約設定（任意・未設定なら経済的な既定値）──────
# src/lib/ai-budget.ts 参照。最大の消費源はチャット。
AI_CHAT_HISTORY_TURNS=6      # モデルへ渡す直近履歴の件数（少ないほど入力トークン減）
AI_CHAT_MAX_TOKENS=320       # チャット応答の最大出力トークン
AI_CHAT_TOPIC_SEED_TURNS=4   # 会話序盤（履歴がこの件数未満）のみ話題シードを付与
AI_PHOTO_FEEDBACK=casual-only # 写真フィードバックのビジョン利用範囲: all | casual-only | off
                              #   casual-only=道中の共有写真のみAI（クエスト証拠はルールベース・節約）

# ── Web Push 通知（任意）───────────────────────────
# VAPID 鍵ペア。未設定だと Push 機能は無効（subscribePush() が 'unconfigured' を返す）。
# 鍵の生成: node -e "console.log(require('web-push').generateVAPIDKeys())"
#   → publicKey を VAPID_PUBLIC_KEY と NEXT_PUBLIC_VAPID_PUBLIC_KEY の両方に、
#     privateKey を VAPID_PRIVATE_KEY に設定する（private は秘匿。ここには実値を書かない）。
# サーバ送信には Supabase の push_subscriptions テーブル（supabase/schema.sql）も必要。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── iOS Push (APNs)（任意・ネイティブ iOS アプリ専用）─────
# Capacitor でラップした iOS アプリへの直接 Push に使用。Web 本番デプロイには不要。
# 4つすべて揃って初めて有効（isApnsConfigured）。未設定なら APNs 送信はスキップ。
APNS_KEY_ID=          # APNs 認証キー(.p8)の Key ID
APNS_TEAM_ID=         # Apple Team ID（例: 576D2UUHH5）
APNS_BUNDLE_ID=       # アプリのバンドルID（apns-topic。例: biz.kaseijin.yaorozu）
APNS_PRIVATE_KEY=     # .p8 ファイルの中身（PKCS#8 PEM。改行は実改行 or \n エスケープ可）
APNS_PRODUCTION=      # 'true' で本番(api.push.apple.com)。未設定/その他は Sandbox。

# ── 定期実行 (Vercel Cron)（任意）──────────────────
# 週次「神様からの手紙」生成 (/api/cron/weekly-letter) と
# 日次ストリークリマインダー (/api/cron/streak-reminder) の認可に使う共有シークレット。
# 未設定だと cron ルートは 503 で no-op（安全側に倒す）。
# Vercel では Project Settings に登録すると、Cron 実行時に
# Authorization: Bearer <CRON_SECRET> として自動付与される（vercel.json の crons 参照）。
# 手動/外部 cron から叩くときは ?key=<CRON_SECRET> でも可。
CRON_SECRET=
